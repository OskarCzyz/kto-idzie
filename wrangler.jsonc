{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kto-idzie",
	"main": "./src/worker/index.ts",
	"compatibility_date": "2025-09-01",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kto-idzie",
			"database_id": "2a5017a2-11df-406c-9a10-9ecbf0a5a127",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "kto-idzie-photos"
		}
	],
	"vars": {
		"DEV_AUTH": "0",
		"ORGANIZER_TELEGRAM_IDS": "106027552" // your Telegram USER id from @userinfobot (digits only), NOT the bot token
	}
}